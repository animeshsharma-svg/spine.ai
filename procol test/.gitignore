# Safety net: this file exists so that even if a git repository is initialised
# INSIDE this project folder (VS Code's "Publish to GitHub" does exactly that
# when you open the folder directly), secrets and bulk still cannot be
# committed. The real repository root is the PARENT directory.
.env
.env.*
!.env.example
.auth/
node_modules/
.npm-cache/
data/vector-store.json
findings/
test-results/
playwright-report/
# Per-run API evidence + the report built from it.
reports/
blob-report/
public/shots/
src/public/shots/
*.log
.DS_Store
