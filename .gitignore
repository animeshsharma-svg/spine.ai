# ─────────────────────────────────────────────────────────────────────────────
# PROCOL'S OWN SOURCE — NEVER COMMIT
# These are company repositories, checked out here read-only as reference for
# the QA platform. They are not part of this project and must not leave it.
# ─────────────────────────────────────────────────────────────────────────────
procol-backend/
procol-client-dashboard/

# ── Secrets ──────────────────────────────────────────────────────────────────
# .env holds API keys (Groq, Google), sandbox app keys/secrets and access
# tokens. Copy .env.example instead; never commit a real .env.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Live browser session state — real access tokens for the sandbox.
.auth/
**/.auth/

# ── Dependencies and caches ──────────────────────────────────────────────────
node_modules/
**/node_modules/
.npm-cache/
**/.npm-cache/
.DS_Store
*.log

# ── Generated at run time ────────────────────────────────────────────────────
# The vector store is rebuilt with `npm run rag:build` and is several MB.
prototype/data/vector-store.json
# Screenshots the platform captures while running.
prototype/src/public/shots/
prototype/public/shots/

# Playwright output: reports, traces, videos, screenshots.
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/
.playwright/
**/playwright/.cache/

# Oracle findings are a record of runs against a live environment, not source.
findings/
**/findings/

# Compiled plans and their results — regenerated on every run, and the results
# are consumed as RAG "experience" from disk rather than from the repo.
.plans/
**/.plans/
# Where a locator got stuck: a screenshot plus an accessibility dump of a live
# page. Evidence for the teach-this-locator flow, not source. What is LEARNED
# from it lands in locators.learned.json, which IS committed.
stuck/
**/stuck/

# Editor/OS noise
.idea/
*.swp
*~

# Recorded API flows — real requests against a live env; regenerated by recording.
recordings/
**/recordings/
# Converted recordings carry real live response data (event/company names) — never commit.
prototype/data/recorded-*.cases.json
prototype/test-cases/recorded-*.md

# Per-case evidence records written by vendor bulk upload runs (run output, like data/runs)
prototype/data/evidence/

# HubSpot support tickets — CUSTOMER DATA. Raw exports, stripped records, cached
# reproduction plans: never committed. Only code, the migration, the 100%
# synthetic fixture and aggregate counts are.
prototype/data/hubspot/
prototype/data/hubspot-*.json
data/hubspot/
data/hubspot-*.json
