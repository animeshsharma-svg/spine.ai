# ─────────────────────────────────────────────────────────────────────────────
# PROCOL'S OWN SOURCE — NEVER COMMIT
# These are company repositories, checked out here read-only as reference for
# the QA platform. They are not part of this project and must not leave it.
# ─────────────────────────────────────────────────────────────────────────────
procol-backend/
procol-client-dashboard/

# ── Secrets ──────────────────────────────────────────────────────────────────
# .env holds API keys (Groq, Google), sandbox app keys/secrets and access
# tokens. Copy .env.example instead; never commit a real .env.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Live browser session state — real access tokens for the sandbox.
.auth/
**/.auth/

# ── Dependencies and caches ──────────────────────────────────────────────────
node_modules/
**/node_modules/
.npm-cache/
**/.npm-cache/
.DS_Store
*.log

# ── Generated at run time ────────────────────────────────────────────────────
# The vector store is rebuilt with `npm run rag:build` and is several MB.
prototype/data/vector-store.json
# Screenshots the platform captures while running.
prototype/src/public/shots/
prototype/public/shots/

# Playwright output: reports, traces, videos, screenshots.
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/
.playwright/
**/playwright/.cache/

# Oracle findings are a record of runs against a live environment, not source.
findings/
**/findings/

# Editor/OS noise
.idea/
*.swp
*~
