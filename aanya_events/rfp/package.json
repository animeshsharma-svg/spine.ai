{
  "name": "aanya-events-rfp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RFP event publish on Procol — the 'RFP/RFQ Event Publish' Postman collection as a Playwright API suite: publish, post-publish verification, negative and edge cases.",
  "scripts": {
    "test": "playwright test",
    "test:publish": "RFP_SUITES=publish playwright test",
    "test:verify": "RFP_SUITES=publish,verify playwright test",
    "report": "open reports/rfp-report.html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.7.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
