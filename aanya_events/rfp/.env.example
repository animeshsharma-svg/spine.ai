# RFP event publish — copy to .env and fill in. .env is git-ignored.
#
# The access-token header the console sends. Sign in to cpanel (UAT) →
# DevTools → Network → any sec-api call → copy the `access-token` request
# header. It is a console session and expires; paste a fresh one when the run
# says the token was refused.
AANYA_EVENTS_ACCESS_TOKEN=
# Sign in from Procol's database like the UAT clients (needs DATABASE_URL in
# procol test/.env). With this set, the token above is only a fallback.
AANYA_EVENTS_DB_COMPANY=32461

# The lightspeed-token header from the same request (optional).
AANYA_EVENTS_LIGHTSPEED_TOKEN=

# Host without /api. Defaults to UAT.
RFP_BASE_URL=https://sec-api.ag-ri.in
RFP_APP_VERSION=9.4.377

# Anything below is optional — leave it out to use the default. Every setting
# the collection had is an RFP_<NAME> variable (see src/config.ts), e.g.:
# RFP_NUM_LINE_ITEMS=2
# RFP_QUANTITIES=5,10        one value for every item, or one per item
# RFP_NUM_VENDORS=3
# RFP_PRODUCT_SEARCH_QUERY=a
# RFP_TEMPLATE_NAME=technical test
# RFP_SUITES=publish,verify,negative
# RFP_SCENARIO=3             run one of the rows in src/scenarios.ts
