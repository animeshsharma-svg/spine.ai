# Copy to .env and fill in real values. Never commit .env.
#
# Onboarding a client needs exactly two variables: its base URL and a token.
# Module and datasource UUIDs are discovered, never configured by hand.
# Name them to match `baseUrlEnv` / `auth.*Env` in config/clients/<id>.json.

# --- procol_sandbox_demo -------------------------------------------------
# auth type "apiKey", sent as the "access-token" header.
PROCOL_SANDBOX_DEMO_BASE_URL=https://procol-sandbox-demo-proco-internal-demo.ag-ri.in
PROCOL_SANDBOX_DEMO_ACCESS_TOKEN=

# --- example: a second client -------------------------------------------
# DECATHLON_BASE_URL=https://sec-api.ag-ri.in
# DECATHLON_ACCESS_TOKEN=
# Use an ADMIN token for discovery: the module list is permission-filtered,
# so a restricted user silently produces a smaller account.

# --- database audit (optional, never used by tests) ----------------------
# `npm run audit` resolves the two things the API cannot express: numeric
# datasource ids, and the autofill graph behind `reference` fields.
# AUDIT_DATABASE_URL=postgresql://user:password@host:5432/database
# <CLIENT_ID>_TENANT_ID identifies the client's tenant in that database.
# DECATHLON_TENANT_ID=

# --- test gates ----------------------------------------------------------
# RUN_LIVE_TESTS=1     read-only calls against a real account
# RUN_WRITE_TESTS=1    creates real records — off by default
# BUDGET_SCHEMA_MS=3000   response-time budget for a schema fetch
# BUDGET_MODULES_MS=4000  response-time budget for the module list
