{
  "name": "procol-api-suite",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "The purchase-order API automation the platform drives: creates a PO end to end from config/po-input.json, then reports it.",
  "scripts": {
    "po": "tsx src/cli/createPo.ts",
    "report:po": "tsx src/report/buildApiReport.ts",
    "report:bugs": "tsx src/report/buildBugReport.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "yaml": "^2.9.0"
  }
}
