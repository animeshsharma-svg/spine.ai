{
  // Procol's own repositories happen to live inside this folder as read-only
  // reference. VS Code detects them as git repositories and will happily let
  // you commit into them, which is exactly what we do not want — so hide them
  // from the Source Control panel. They stay on disk and remain readable.
  "git.ignoredRepositories": [
    "/Users/animesh/Desktop/procol/procol-backend",
    "/Users/animesh/Desktop/procol/procol-client-dashboard"
  ],
  // Only look for repositories at the workspace root, not in every subfolder.
  "git.autoRepositoryDetection": "openEditors",
  "git.confirmSync": true,
  "files.exclude": {
    "**/node_modules": true,
    "**/.npm-cache": true
  }
}
