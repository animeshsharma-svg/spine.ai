# Procol UI Tests — environment configuration (copy to .env; .env is git-ignored)
# ---------------------------------------------------------------------------
# Everything has a sane default in src/config.ts for clientA, so .env is only
# needed to override the environment/credentials or to add a NEW client.
# ---------------------------------------------------------------------------

# Which client profile to run against (a key in CLIENTS, or any name you define
# entirely via <NAME>_* vars below).
ACTIVE_CLIENT=

# ── Generic one-off overrides (win over everything; handy for ad-hoc runs) ────
# APP_URL=
# API_URL=
# BUYER_PHONE=
# BUYER_PHONE_PREFIX=+91
# OTP=
# APP_KEY=
# APP_SECRET=
# APP_VERSION=

# ── clientA (defaults live in code; override here only if the env rotates) ─────
# CLIENTA_APP_URL=https://cpanel.ag-ri.in
# CLIENTA_API_URL=https://sec-api.ag-ri.in/api
# CLIENTA_BUYER_PHONE=1234567516
# CLIENTA_OTP=130899

# ── Add a brand-new client with ZERO code changes ─────────────────────────────
# Pick any name, set ACTIVE_CLIENT to it, and provide its frontend + backend +
# login. Because the console reads its backend from localStorage, any frontend
# build can be pointed at any backend.
#   ACTIVE_CLIENT=acme
#   ACME_APP_URL=https://acme-console.example
#   ACME_API_URL=https://acme-api.example/api
#   ACME_BUYER_PHONE=99xxxxxxxx
#   ACME_OTP=xxxxxx
#   ACME_APP_KEY=...        # only if this client uses non-default console keys
#   ACME_APP_SECRET=...
#   ACME_APP_VERSION=...
DATABASE_URL=
