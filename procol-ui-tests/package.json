{
  "name": "procol-ui-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Playwright (browser) UI-automation framework for the Procol client console. Mirrors the procol-api-tests FlowModule registry so UI + API flows are orchestratable by one agent.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:master": "playwright test tests/ui-master.spec.ts",
    "test:auth": "playwright test --project=setup",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
