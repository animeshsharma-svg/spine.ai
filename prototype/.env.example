# Slingring — Procol's OpenAI-compatible gateway (http://slingring.procol.tech).
# Get a key from the HACK26 invitation link. When set, it is the primary LLM
# (HACK26_GPT_6_ASTRA for the compiler, HACK26_GPT_5_6_LUNA for the inner loop)
# and the embedder for the QA memory (HACK26_TEXT_EMBED_3_LARGE).
# After adding it, rebuild the memory:  npm run rag:build
SLINGRING_API_KEY=
# Optional overrides
# SLINGRING_BASE_URL=http://slingring.procol.tech
# SLINGRING_REASON_MODEL=HACK26_GPT_6_ASTRA
# SLINGRING_FAST_MODEL=HACK26_GPT_5_6_LUNA
# EMBEDDINGS_PROVIDER=local      # force the local 384-dim model even with a key

# Free Groq API key — enables LLM-written agent reasoning. Get one at https://console.groq.com
# Leaving it blank runs the platform in deterministic fallback mode.
GROQ_API_KEY=

# ── Sandbox preview env (multi-company feature) ───────────────────────────
# Paste the procol_access_token from the logged-in preview frontend here, then run:
#   npm run multi-company
# (Log into the preview as a multi-company user → F12 → Application → Local Storage → procol_access_token)
SANDBOX_ACCESS_TOKEN=
# Optional: which multi-company user to test (used only if you give app keys instead of a token)
SANDBOX_USER_ID=
# Optional alternative to the token: the sandbox's app key + secret (I decode these from the token too)
SANDBOX_APP_KEY=
SANDBOX_APP_SECRET=
SANDBOX_APP_VERSION=

# Google AI Studio key (free, no billing) for the Stagehand UI layer — paste yours after =
GOOGLE_API_KEY=
