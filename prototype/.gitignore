# Safety net: this file exists so that even if a git repository is initialised
# INSIDE this project folder (VS Code's "Publish to GitHub" does exactly that
# when you open the folder directly), secrets and bulk still cannot be
# committed. The real repository root is the PARENT directory.
.env
.env.*
!.env.example
.auth/
node_modules/
.npm-cache/
data/vector-store.json
findings/
test-results/
playwright-report/
blob-report/
public/shots/
src/public/shots/
*.log
.DS_Store

# product-model snapshots: fallback copies of client template data (the spine DB holds them)
src/model/snapshots/

# matcher LLM cache (per machine)
prompts/.matcher-cache.json

# Generated run artefacts: real UAT responses, kept on the machine and in the
# spine database — never in git (they can carry client data).
data/runs/
data/ui-trails/
data/matrix/
data/nightly/*
!data/nightly/.gitignore
data/backend-watch/*
!data/backend-watch/.gitignore

# HubSpot support tickets — customer data, never committed (see root .gitignore)
data/hubspot/
data/hubspot-*.json

# memory eval runs: keep only the committed baseline and final reference
data/evals/results/*
!data/evals/results/memory-baseline-*.json
!data/evals/results/memory-final-*.json

# Run output from the RFP and PO runners (like data/runs): never committed
data/rfp-runs/
data/po-runs/

# Walk/combination runs (run output) — the screen records, memory pages and their pictures (data/screens/img) stay in git
data/screens/walks/
data/combos/
data/journeys/
data/sheet-runs/
data/sheet-cases.json
data/sheet-campaigns/
data/automation-backlog.json
