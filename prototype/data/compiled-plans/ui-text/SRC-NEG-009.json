     "name": "Revoke Counter Offer",
     "within": "Vendor A"
    },
    "note": "Revoke the pending counter offer for Vendor A."
   },
   {
    "step": "expect_visible",
    "args": {
     "role": "button",
     "name": "Counter Offer",
     "within": "Vendor A",
     "visible": true
    },
    "note": "Verify the counter-offer action is available again after revocation."
   },
   {
    "step": "expect_visible",
    "args": {
     "role": "button",
     "name": "Revoke Counter Offer",
     "within": "Vendor A",
     "visible": false
