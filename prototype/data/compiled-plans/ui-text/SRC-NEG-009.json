    "note": "Verify no pending counter offer remains on the buyer side."
   },
   {
    "step": "open_master_qcs",
    "args": {
     "vendors": [
      "Vendor A"
     ]
    },
    "note": "Open the comparison grid to verify the original bid is active."
   },
   {
    "step": "expect_qcs_cell",
    "args": {
     "row": "RFQ Rate",
     "vendor": "Vendor A",
     "equals": "100"
    },
    "note": "Verify Vendor A's original bid price of 100 is restored."
   },
   {
    "step": "switch_portal",
    "args": {
     "to": "vendor",
     "vendor": "Vendor A"
    },
    "note": "Switch to Vendor A's supplier portal session."
   },
   {
    "step": "vendor_open_event",
    "args": {
     "stage": "pricing"
    },
    "note": "Open the RFQ pricing round for Vendor A."
   },
   {
    "step": "expect_text",
    "args": {
     "text": "Counter Offer",
     "present": false
    },
    "note": "Verify Vendor A no longer sees a pending counter offer."
   },
   {
    "step": "vendor_bid",
    "args": {
