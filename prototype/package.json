{
  "name": "procol-qa-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous-QA platform for Procol \u2014 hackathon prototype (multi-agent AI over the existing Playwright flows).",
  "scripts": {
    "check:catalog": "node scripts/check-catalog.mjs",
    "run:flow": "tsx src/cli-run-flow.ts",
    "rag:build": "tsx src/cli-rag.ts build",
    "rag:query": "tsx src/cli-rag.ts query",
    "orchestrate": "tsx src/cli-orchestrate.ts",
    "pr": "tsx src/cli-pr.ts",
    "multi-entity": "tsx src/cli-multi-entity.ts",
    "multi-company": "tsx src/cli-multi-company.ts",
    "serve": "tsx src/server.ts",
    "show:checks": "tsx scripts/show-checks.ts",
    "ui:stagehand": "tsx scripts/stagehand-smoke.ts",
    "eval:routing": "tsx scripts/eval-routing.ts",
    "typecheck": "tsc --noEmit",
    "eval:planner": "tsx scripts/eval-planner.ts",
    "cases:import": "tsx scripts/import-test-cases.ts",
    "cases:coverage": "tsx scripts/coverage-report.ts",
    "cases:api": "tsx scripts/try-api-cases.ts",
    "cases:compile": "tsx scripts/try-compile.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "xlsx": "^0.18.5"
  }
}
