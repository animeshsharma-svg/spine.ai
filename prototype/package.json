    "orchestrate": "tsx src/cli-orchestrate.ts",
    "pr": "tsx src/cli-pr.ts",
    "multi-entity": "tsx src/cli-multi-entity.ts",
    "multi-company": "tsx src/cli-multi-company.ts",
    "serve": "tsx watch src/server.ts",
    "show:checks": "tsx scripts/show-checks.ts",
    "ui:stagehand": "tsx scripts/stagehand-smoke.ts",
    "eval:routing": "tsx scripts/eval-routing.ts",
    "typecheck": "tsc --noEmit",
    "eval:planner": "tsx scripts/eval-planner.ts",
    "cases:import": "tsx scripts/import-test-cases.ts",
    "product:import": "tsx scripts/import-product-knowledge.ts",
    "cases:coverage": "tsx scripts/coverage-report.ts",
    "coverage:report": "tsx scripts/coverage-truth.ts",
    "cases:api": "tsx scripts/try-api-cases.ts",
    "cases:compile": "tsx scripts/try-compile.ts",
    "cases:journeys": "tsx scripts/build-journeys.ts",
