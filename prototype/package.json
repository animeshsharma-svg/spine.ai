{
  "name": "spine-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "spine.ai \u2014 the autonomous QA platform for Procol (multi-agent AI over the existing Playwright flows).",
  "scripts": {
    "check:catalog": "node scripts/check-catalog.mjs",
    "run:flow": "tsx src/cli-run-flow.ts",
