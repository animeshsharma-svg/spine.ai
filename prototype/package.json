    "db:backfill": "tsx scripts/db-backfill.ts",
    "db:sync-catalog": "tsx scripts/db-sync-catalog.ts",
    "db:reconcile": "tsx scripts/db-reconcile.ts",
    "db:retention": "tsx scripts/db-retention.ts",
    "db:export-bugs": "tsx scripts/export-bug-sheet.ts",
    "db:unit": "node --import tsx --test --test-reporter=spec scripts/db-unit-tests.ts",
    "vbu:bugsheet": "tsx scripts/vbu-bug-sheet.ts",
    "vbu:bugpage": "tsx scripts/vbu-bug-sheet-page.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "xlsx": "^0.18.5"
  }
