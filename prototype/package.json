    "backend:cases": "tsx scripts/run-backend-cases.ts",
    "vbu:run": "tsx scripts/run-vendor-bulk.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import-runs": "tsx scripts/db-import-runs.ts",
    "model:build": "tsx scripts/model-build.ts",
    "ci:check": "tsx scripts/ci-check.ts",
    "ci:unit": "node --import tsx --test --test-reporter=spec scripts/ci-unit-tests.ts",
    "nightly": "tsx scripts/nightly.ts",
    "backend:watch": "tsx scripts/backend-watch.ts",
    "eval:matcher": "tsx scripts/eval-matcher.ts",
    "template:check": "tsx scripts/template-check.ts",
    "matrix": "tsx scripts/run-matrix.ts",
    "eval:memory": "tsx scripts/eval-memory.ts",
    "hubspot:ingest": "tsx scripts/hubspot-ingest.ts",
    "hubspot:reproduce": "tsx scripts/hubspot-reproduce.ts",
